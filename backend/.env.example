# Local / test settings. Copy to .env.  Real environment variables always win; .env fills what is missing.
# Used by BOTH ways of running: Docker Compose and `python -m app`.

JWT_SECRET=change-me-generate-with-openssl-rand-hex-32

POSTGRES_USER=checklists
POSTGRES_PASSWORD=change-me
POSTGRES_DB=checklists

# Manual run only (python -m app): where your PostgreSQL is. Docker uses its own db container.
DB_HOST=localhost
DB_PORT=5432
# Or give the whole URL instead of the five lines above:
# DATABASE_URL=postgresql+psycopg://checklists:change-me@localhost:5432/checklists

# Uploaded logos/images/PDFs.
#   manual: folder backend/uploads      docker: a Docker volume named "uploads"
UPLOADS_HOST_DIR=uploads

# 1 = interactive API docs at /api/docs (also /docs) and auto-reload for `python -m app`
DEBUG=1

# Manual run: http://127.0.0.1:8000.  Docker publishes 0.0.0.0:8000 (change with API_PORT / BIND_ADDR).
PORT=8000
# HOST=0.0.0.0
# API_PORT=8000
# BIND_ADDR=0.0.0.0
# FRONTEND_DIR=../frontend    # default; "off" = API only
