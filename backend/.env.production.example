# Production (server): copy to /opt/checklists/backend/.env  — nginx serves the frontend and proxies /api
JWT_SECRET=generate-with-openssl-rand-hex-32
POSTGRES_USER=checklists
POSTGRES_PASSWORD=use-a-long-random-password
POSTGRES_DB=checklists

# uploads: host folder served by nginx at /files/ (owned by uid 1001, see scripts/server-setup.sh)
UPLOADS_HOST_DIR=/srv/checklists/uploads

# API only on localhost:8100 (matches nginx/checklists.conf); frontend comes from nginx
BIND_ADDR=127.0.0.1
API_PORT=8100
FRONTEND_DIR=off
DEBUG=0
